# ===== 基本設定 =====
# サービス名(画面に表示されます。販売時は自社のサービス名に変更)
APP_NAME=営業AIプラットフォーム
PORT=3000

# ===== AI(Claude API) =====
# 未設定の場合は「デモモード」で動きます
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ===== 販売・運用の設定 =====
# true にすると、ログイン画面から誰でも新規登録(無料トライアル)できます。
# 社内だけで使う場合は false のまま(最初に登録した1社が「社内利用」プランになり、
# 以降のメンバーは招待で追加します)
ALLOW_SIGNUP=false

# このサービスの公開URL(メール内のリンクや、決済後の戻り先に使います)
APP_URL=http://localhost:3000

# 外部CRMの接続情報を暗号化する鍵(本番では必須)。次のコマンドで作れます:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# 本番環境では production に(Cookie が HTTPS 限定になります)
NODE_ENV=development
# ロードバランサーやリバースプロキシの後ろで動かす場合は 1
TRUST_PROXY=
# データの保存先フォルダ
DATA_DIR=

# ===== メール送信(SMTP) =====
# 未設定の場合は送信せず、サーバーのログに内容を表示します。
# 例)SendGrid:SMTP_HOST=smtp.sendgrid.net / SMTP_USER=apikey / SMTP_PASS=(APIキー)
#     Amazon SES:SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 差出人(送信ドメインの SPF・DKIM 設定を済ませたアドレスにしてください)
MAIL_FROM=営業AIプラットフォーム <no-reply@example.com>

# ===== 決済(Stripe) =====
# 未設定の場合、オンライン決済は無効になります(プラン変更は運営者がコマンドで行う)
STRIPE_SECRET_KEY=
# スタンダードプランの価格ID(Stripe の商品カタログで作成した月額料金の price_...)
STRIPE_PRICE_STANDARD=
# Webhook の署名シークレット(whsec_...)
STRIPE_WEBHOOK_SECRET=
# 消費税を Stripe Tax で自動計算する場合は true
STRIPE_AUTOMATIC_TAX=false
# エンタープライズプランなどの問い合わせ先
SALES_CONTACT_EMAIL=

# ===== 運用・監視 =====
# 障害の通知先(Slack・Teams などの Incoming Webhook URL)。未設定ならログに出すだけ
ALERT_WEBHOOK_URL=
# true にすると、APIへのアクセスを1行ずつ記録します(個人情報は含みません)
LOG_REQUESTS=false
# 自動バックアップ(1日1回)の保存先と、残す世代数
BACKUP_DIR=
BACKUP_KEEP=14
# 1社あたりのAI同時実行数の上限
AI_MAX_CONCURRENT_PER_TENANT=3
