# ===== 基本設定 =====
# サービス名(画面に表示されます。販売時は自社のサービス名に変更)
APP_NAME=営業AIプラットフォーム
PORT=3000

# ===== AI(Claude API) =====
# 未設定の場合は「デモモード」で動きます
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ===== 販売・運用の設定 =====
# true にすると、ログイン画面から誰でも新規登録(無料トライアル)できます。
# 社内だけで使う場合は false のまま(最初に登録した1社が「社内利用」プランになり、
# 以降のメンバーは招待で追加します)
ALLOW_SIGNUP=false

# 外部CRMの接続情報を暗号化する鍵(本番では必須)。次のコマンドで作れます:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# 本番環境では production に(Cookie が HTTPS 限定になります)
NODE_ENV=development
# ロードバランサーやリバースプロキシの後ろで動かす場合は 1
TRUST_PROXY=
# データの保存先フォルダ
DATA_DIR=
